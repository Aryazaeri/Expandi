# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by the SMS / e-mail webhooks and the FX cron job. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional — enables the AI advisor chat, PDF statements, AI categorization and the SMS fallback parser
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/fx
CRON_SECRET=change-me

# Optional — public URL shown in the setup instructions (defaults to the request host)
# NEXT_PUBLIC_SITE_URL=https://expandi.vercel.app
